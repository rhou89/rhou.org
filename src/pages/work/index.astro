---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';

const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Work"
  description="Selected work by Ryan Hou across large-scale AI systems, technical leadership, and quantum technologies."
  noindex
>
  <PageIntro
    eyebrow="Work"
    title="Selected work"
    description="Technical and leadership work across recommendation systems, generative retrieval, causal optimization, and quantum computing. Details are limited to publicly shareable context."
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <SectionHeading eyebrow="Case notes" count={allWork.length} />
    <div>{allWork.map((entry) => <WorkRow entry={entry} />)}</div>
  </section>
</BaseLayout>
