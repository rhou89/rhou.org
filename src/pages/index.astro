---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PublicationRow from '@/components/PublicationRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';

const publications = (await getCollection('publications'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={SITE.name}>
  <section class="border-line border-b">
    <div
      class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-20 lg:py-24"
    >
      <div>
        <h1
          class="font-display text-ink text-4xl leading-tight font-semibold tracking-[-0.025em] sm:text-5xl"
        >
          Ryan Hou
        </h1>
        <p class="text-ink-soft mt-2 text-base italic sm:text-lg">
          Technology Leader & Interdisciplinary Researcher
        </p>

        <div class="mt-7 flex flex-wrap gap-2">
          <span
            class="border-line text-ink-soft rounded-full border px-3 py-1.5 font-mono text-[11px]"
            >AI Systems</span
          >
          <a
            href="/publications"
            class="border-line text-ink-soft hover:border-signal hover:text-ink rounded-full border px-3 py-1.5 font-mono text-[11px] transition-colors"
            >Quantum Technologies</a
          >
        </div>

        <p class="text-ink mt-8 max-w-3xl text-base leading-8 sm:text-[1.0625rem]">
          {SITE.intro}
        </p>
        <p class="font-display text-ink-soft mt-6 text-lg italic">{SITE.tagline}</p>

        <nav
          class="mt-8 flex flex-wrap gap-x-6 gap-y-3 font-mono text-xs"
          aria-label="Profile links"
        >
          <a href="/publications" class="text-signal hover:underline">Publications →</a>
          <a href="/cv" class="text-signal hover:underline">CV →</a>
        </nav>
      </div>

      <aside
        class="border-line border-t pt-8 lg:border-t-0 lg:border-l lg:pt-1 lg:pl-9"
        aria-label="Current appointments"
      >
        <p class="text-ink-soft font-mono text-[11px] tracking-[0.18em] uppercase">Currently</p>
        <div class="mt-6 space-y-6">
          <div>
            <p class="font-display text-ink text-lg">Pinterest</p>
            <p class="text-ink-soft mt-1 text-sm leading-relaxed">
              Tech Lead, Machine Learning<br />Closeup retrieval & multi-modal search
            </p>
          </div>
          <div class="border-line border-t pt-6">
            <p class="font-display text-ink text-lg">Washington University in St. Louis</p>
            <p class="text-ink-soft mt-1 text-sm leading-relaxed">
              Visiting Researcher<br />Quantum sensing & engineering
            </p>
          </div>
        </div>
        <div
          class="border-line mt-7 flex flex-wrap gap-x-4 gap-y-2 border-t pt-5 font-mono text-[11px]"
        >
          <a
            href="https://scholar.google.com/citations?user=mJJxP8EAAAAJ"
            target="_blank"
            rel="noreferrer"
            class="text-ink-soft hover:text-signal">Scholar ↗</a
          >
          <a
            href="https://www.linkedin.com/in/ryanjhou/"
            target="_blank"
            rel="noreferrer"
            class="text-ink-soft hover:text-signal">LinkedIn ↗</a
          >
          <a href={`mailto:${SITE.email}`} class="text-ink-soft hover:text-signal">Email ↗</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-line border-y">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[15rem_1fr]">
      <div>
        <p class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">Publications</p>
        <h2 class="font-display text-ink mt-5 text-2xl leading-tight sm:text-3xl">
          Across disciplines
        </h2>
        <p class="text-ink-soft mt-4 text-sm leading-relaxed">
          Selected work spanning recommender systems, quantum information, nonlinear dynamics, and
          photonics.
        </p>
        <a
          href="/publications"
          class="text-signal mt-6 inline-block font-mono text-xs hover:underline"
          >View all publications →</a
        >
      </div>
      <div>{publications.map((entry) => <PublicationRow entry={entry} />)}</div>
    </div>
  </section>

  <section
    class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-2 lg:gap-20"
  >
    <div>
      <SectionHeading eyebrow="Across systems and science" />
      <p class="font-display text-ink text-2xl leading-snug">
        A continuous thread through computer science, quantum physics, and production AI.
      </p>
      <p class="text-ink-soft mt-4 max-w-xl leading-relaxed">
        My approach remains consistent across domains: start from first principles, connect ideas
        across fields, and carry them through to real-world systems.
      </p>
      <a href="/about" class="text-signal mt-6 inline-block font-mono text-xs hover:underline"
        >More about the work →</a
      >
    </div>
    <div id="contact">
      <SectionHeading eyebrow="Connect" />
      <p class="font-display text-ink text-2xl leading-snug">
        For research collaborations, technical leadership, and deep-technology translation.
      </p>
      <a
        href={`mailto:${SITE.email}`}
        class="text-signal mt-6 inline-flex font-mono text-sm hover:underline">{SITE.email} ↗</a
      >
    </div>
  </section>
</BaseLayout>
