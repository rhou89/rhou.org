---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import PublicationRow from '@/components/PublicationRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
);
const ai = publications.filter((entry) => entry.data.topics.includes('AI Systems'));
const quantum = publications.filter((entry) => !entry.data.topics.includes('AI Systems'));
---

<BaseLayout
  title="Publications"
  description="Publications by Ryan Hou across AI systems, quantum information, nonlinear dynamics, and photonics."
>
  <PageIntro
    eyebrow="Publication record"
    title="Publications"
    description="My publication record spans industrial recommender systems, quantum information, nonlinear dynamics, topological photonics, and quantum matter. A total of 40+ publications including 6 Phys. Rev. Lett., 1 Nat. Common., 2 KDD and 2 SIGIR."
  >
    <a
      href="https://scholar.google.com/citations?user=mJJxP8EAAAAJ"
      target="_blank"
      rel="noreferrer"
      class="text-signal mt-6 inline-block font-mono text-xs hover:underline"
      >Full record on Google Scholar ↗</a
    >
  </PageIntro>

  <section>
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[14rem_1fr]">
      <div>
        <p class="text-ink-soft font-mono text-[11px] tracking-[0.18em] uppercase">
          01 / AI Systems
        </p>
        <h2 class="font-display text-ink mt-4 text-2xl leading-snug">
          Recommendation, retrieval & distribution
        </h2>
      </div>
      <div>
        <SectionHeading eyebrow="Selected publications" count={ai.length} />
        {ai.map((entry) => <PublicationRow entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="border-line border-t">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[14rem_1fr]">
      <div>
        <p class="text-ink-soft font-mono text-[11px] tracking-[0.18em] uppercase">02 / Quantum</p>
        <h2 class="font-display text-ink mt-4 text-2xl leading-snug">
          Information, matter & photonics
        </h2>
      </div>
      <div>
        <SectionHeading eyebrow="Selected publications" count={quantum.length} />
        {quantum.map((entry) => <PublicationRow entry={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>
