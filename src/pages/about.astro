---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';

const principles = [
  ['Think from first principles', 'Understand the mechanism before optimizing the metric.'],
  [
    'Move between layers',
    'Connect research, modeling, infrastructure, product, and organizational execution.',
  ],
  [
    'Build for measurable impact',
    'A strong idea matters most when it survives contact with the real world.',
  ],
];
---

<BaseLayout
  title="About"
  description={`About ${SITE.name}, technology leader and interdisciplinary researcher.`}
>
  <PageIntro
    eyebrow="About"
    title="Across systems and science"
    description="My work spans computer science, quantum physics, and production AI as a connected practice—grounded in a consistent way of thinking and shaped by new questions and opportunities."
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-24">
      <div>
        <p class="text-ink-soft font-mono text-[11px] tracking-[0.18em] uppercase">
          Current appointments
        </p>
        <dl class="mt-6 space-y-6">
          <div>
            <dt class="font-display text-ink text-xl">Pinterest</dt>
            <dd class="text-ink-soft mt-1 text-sm leading-relaxed">
              Tech Lead, Machine Learning<br />Closeup retrieval & multi-modal search
            </dd>
          </div>
          <div class="border-line border-t pt-6">
            <dt class="font-display text-ink text-xl">Washington University in St. Louis</dt>
            <dd class="text-ink-soft mt-1 text-sm leading-relaxed">
              Visiting Researcher<br />Quantum sensing & engineering
            </dd>
          </div>
        </dl>
      </div>
      <div class="prose prose-base max-w-2xl">
        <p>
          My foundation in computer science expanded into quantum and computational physics. Today I
          lead machine-learning systems at Pinterest while continuing research in quantum
          technologies, with each area sharpening how I think about the other.
        </p>
        <p>
          AI engineering and quantum science are not separate chapters in my work. Across Pinterest,
          Meta, Microsoft Research, and academia, the common thread has been building rigorous
          solutions to complex problems—whether the output is a production recommender system, a
          quantum-inspired optimizer, or a new scientific result.
        </p>
        <p>
          I am most energized by work that crosses traditional boundaries: theory and execution,
          science and product, individual depth and team leadership. I care about asking the right
          question, making the technical structure legible, and helping a group move from an idea to
          an outcome.
        </p>
      </div>
    </div>
  </section>

  <section class="border-line border-y">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <SectionHeading eyebrow="How I work" />
      <div class="grid gap-8 md:grid-cols-3 md:gap-10">
        {
          principles.map(([title, description], index) => (
            <article class="border-line border-t pt-5">
              <p class="text-ink-soft font-mono text-[11px]">0{index + 1}</p>
              <h2 class="font-display text-ink mt-5 text-xl">{title}</h2>
              <p class="text-ink-soft mt-2 text-sm leading-relaxed">{description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading eyebrow="Education" />
        <p class="font-display text-ink text-xl">Ph.D. in Physics</p>
        <p class="text-ink-soft mt-1 text-sm leading-relaxed">
          Quantum & Computational Physics · The University of Texas at Dallas · 2021
        </p>
        <p class="font-display text-ink mt-7 text-xl">B.E. in Computer Science</p>
        <p class="text-ink-soft mt-1 text-sm leading-relaxed">
          Nanjing University of Aeronautics and Astronautics · 2016
        </p>
      </div>
      <div>
        <SectionHeading eyebrow="Connect" />
        <p class="text-ink max-w-xl leading-8">
          For research collaborations, technical leadership, and deep-technology translation.
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="text-signal mt-5 inline-block font-mono text-xs hover:underline">{SITE.email} ↗</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
