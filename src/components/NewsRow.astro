---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils/formatDate';

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { date, category, summary, links } = entry.data;
---

<article
  id={entry.id}
  data-news-entry
  data-category={category.toLowerCase()}
  class="border-line grid scroll-mt-28 grid-cols-[1fr_auto] gap-x-4 gap-y-3 border-b py-6 sm:grid-cols-[7rem_minmax(0,1fr)_auto] sm:gap-6"
>
  <a
    href={`#${entry.id}`}
    class="text-ink-soft hover:text-signal col-start-1 row-start-1 self-start font-mono text-[11px] tracking-wide uppercase transition-colors"
    aria-label={`Link to the update from ${formatDate(date)}`}
  >
    <time datetime={date.toISOString().slice(0, 10)}>
      {formatDate(date, 'monthDay')}
    </time>
  </a>

  <div class="col-span-2 row-start-2 min-w-0 sm:col-span-1 sm:col-start-2 sm:row-start-1">
    <p class="text-ink max-w-3xl leading-7">{summary}</p>
    {
      links.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[11px]">
          {links.map((link) => (
            <a href={link.url} target="_blank" rel="noreferrer" class="text-signal hover:underline">
              {link.label} ↗
            </a>
          ))}
        </div>
      )
    }
  </div>

  <span
    class="border-line text-ink-soft col-start-2 row-start-1 self-start justify-self-end rounded-full border px-2.5 py-1 font-mono text-[10px] tracking-wide uppercase sm:col-start-3"
  >
    {category}
  </span>
</article>
