---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils/formatDate';

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { title, summary, date, url, language } = entry.data;
---

<a
  href={url}
  target="_blank"
  rel="noreferrer"
  class="group border-line grid gap-3 border-b py-5 sm:grid-cols-[7rem_1fr_auto] sm:gap-6"
>
  <span class="text-ink-soft font-mono text-[11px] uppercase">{formatDate(date, 'compact')}</span>
  <span>
    <span
      class="font-display text-ink group-hover:text-signal block text-lg leading-snug transition-colors"
      >{title}</span
    >
    <span class="text-ink-soft mt-1 block text-sm leading-relaxed">{summary}</span>
  </span>
  <span class="text-ink-soft flex items-start gap-3 font-mono text-[11px] uppercase">
    {language}<span class="group-hover:text-signal transition-all group-hover:translate-x-1">↗</span
    >
  </span>
</a>
