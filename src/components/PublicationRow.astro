---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'publications'>;
}

const { entry } = Astro.props;
const { title, venue, year, authorship, note, url } = entry.data;
const Tag = url ? 'a' : 'div';
---

<Tag
  href={url}
  target={url ? '_blank' : undefined}
  rel={url ? 'noreferrer' : undefined}
  class="group border-line grid gap-3 border-b py-5 sm:grid-cols-[7rem_1fr_auto] sm:gap-6"
>
  <span class="text-ink-soft font-mono text-[11px] uppercase">{venue} · {year}</span>
  <span>
    <span
      class="font-display text-ink group-hover:text-signal block text-lg leading-snug transition-colors"
    >
      {title}
    </span>
    {authorship && <span class="text-ink-soft mt-1 block text-sm">{authorship}</span>}
  </span>
  <span class="flex items-start gap-3 sm:justify-end">
    {note && <span class="text-ink-soft font-mono text-[11px] uppercase">{note}</span>}
    {
      url && (
        <span class="text-ink-soft group-hover:text-signal transition-all group-hover:translate-x-1">
          ↗
        </span>
      )
    }
  </span>
</Tag>
