---
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  description: string;
  entries: CollectionEntry<'publications'>[];
}

const { title, description, entries } = Astro.props;
const headingId = `${title.toLowerCase().replaceAll(' ', '-')}-publications`;
---

<section aria-labelledby={headingId}>
  <header class="border-line border-b pb-5 lg:min-h-24">
    <h3 id={headingId} class="text-ink font-mono text-sm font-bold tracking-[0.12em] uppercase">
      {title}
    </h3>
    <p class="text-ink-soft mt-3 max-w-lg text-sm leading-relaxed">{description}</p>
  </header>

  <div>
    {
      entries.map((entry, index) => {
        const { title: publicationTitle, venue, year, authorship, note, url } = entry.data;
        const Tag = url ? 'a' : 'article';

        return (
          <Tag
            href={url}
            target={url ? '_blank' : undefined}
            rel={url ? 'noreferrer' : undefined}
            class:list={['group border-line block border-b', index === 0 ? 'py-6' : 'py-4']}
          >
            <span class="flex items-start justify-between gap-4">
              <span class="text-ink-soft font-mono text-[10px] uppercase">
                {venue} · {year}
              </span>
              {url && (
                <span
                  aria-hidden="true"
                  class="text-ink-soft group-hover:text-signal shrink-0 transition-all group-hover:translate-x-1"
                >
                  ↗
                </span>
              )}
            </span>

            <span
              class:list={[
                'font-display text-ink group-hover:text-signal mt-2 block leading-snug transition-colors',
                index === 0 ? 'text-xl sm:text-[1.375rem]' : 'text-base sm:text-[1.0625rem]',
              ]}
            >
              {publicationTitle}
            </span>

            {(authorship || note) && (
              <span class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                {authorship && <span class="text-ink-soft text-sm">{authorship}</span>}
                {note && (
                  <span class="text-signal font-mono text-[10px] tracking-[0.04em] uppercase">
                    {note}
                  </span>
                )}
              </span>
            )}
          </Tag>
        );
      })
    }
  </div>
</section>
