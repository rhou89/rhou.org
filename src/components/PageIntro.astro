---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-line border-b">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <p class="text-ink-soft font-mono text-[11px] tracking-[0.18em] uppercase">{eyebrow}</p>
    <h1
      class="font-display text-ink mt-4 max-w-3xl text-4xl leading-tight font-semibold tracking-[-0.02em] sm:text-[2.75rem]"
    >
      {title}
    </h1>
    {description && <p class="text-ink-soft mt-5 max-w-2xl leading-8">{description}</p>}
    <slot />
  </div>
</section>
