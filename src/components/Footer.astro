---
import { SITE } from '@/site.config';

const year = new Date().getFullYear();
---

<footer class="border-line border-t">
  <div
    class="text-ink-soft mx-auto flex max-w-6xl flex-col gap-4 px-5 py-8 font-mono text-xs sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p>© {year} {SITE.shortName}. Built for the long arc.</p>

    <nav class="flex items-center gap-4" aria-label="Social">
      {
        SITE.social.map((link) => (
          <a
            href={link.href}
            class="hover:text-signal transition-colors"
            rel="me noreferrer"
            target="_blank"
          >
            {link.label}
          </a>
        ))
      }
      <a href="#top" class="hover:text-signal transition-colors"> Top ↑ </a>
    </nav>
  </div>
</footer>
